{
  "description": "Keeps the Zest auth session fresh at Codex session and prompt boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"$HOME/.codex/plugins/cache/zest/zest/0.0.3/dist/hooks/refresh-auth.js\" SessionStart'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"$HOME/.codex/plugins/cache/zest/zest/0.0.3/dist/hooks/refresh-auth.js\" UserPromptSubmit'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
