{
  "description": "Keeps the Zest auth session fresh at Codex session and prompt boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./dist/hooks/refresh-auth.js\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./dist/hooks/refresh-auth.js\" UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
